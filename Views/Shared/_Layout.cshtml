<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TGRMX Inventario</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TGRMXInventario.styles.css" asp-append-version="true" />
    <style>
        .sidebar-responsive {
            width: 100%;
            z-index: 1040;
        }

        .main-content-responsive {
            margin-top: 85px;
        }

        .nav-pills .nav-link.active {
            background-color: #0d6efd !important;
            color: #ffffff !important;
            font-weight: bold;
        }

        /* Comportamiento exclusivo para Computadora (Pantallas >= 992px) */
        @@media (min-width: 992px) {
            .sidebar-responsive {
                position: fixed !important;
                top: 0;
                bottom: 0;
                left: 0;
                width: 260px !important;
                z-index: 1030;
                display: flex !important;
            }

            .main-content-responsive {
                margin-left: 260px;
                margin-top: 0 !important;
            }

            .navbar-toggler {
                display: none !important;
            }
        }
    </style>
</head>
<body>
    <!-- Barra superior fija exclusiva para Celulares y Tablets -->
    <nav class="navbar navbar-dark bg-dark d-lg-none px-3 fixed-top shadow py-2">
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#sidebarMenu" aria-controls="sidebarMenu" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="d-flex flex-column align-items-center ms-auto me-auto">
            <div class="bg-white rounded-circle d-flex align-items-center justify-content-center shadow-sm mb-1" style="width: 45px; height: 45px;">
                <img src="~/Images/Logo.png" alt="Logo" style="max-height: 75%; max-width: 75%; object-fit: contain;" />
            </div>
            <span class="navbar-brand fs-6 fw-bold m-0 p-0">TGRMX Inventario</span>
        </div>
    </nav>

    <div class="container-fluid p-0">
        <div class="d-flex flex-column flex-lg-row">

            <!-- Barra Lateral Completa -->
            <div class="collapse d-lg-flex flex-column p-3 text-white bg-dark shadow-lg sidebar-responsive h-auto m-0 border-0" id="sidebarMenu">
                <div class="pt-4 pt-lg-0 d-flex flex-column h-100 w-100">

                    <!-- Encabezado de la barra lateral (Computadora / Menú abierto) -->
                    <div class="d-flex align-items-center mb-4 px-2 mt-3 mt-lg-0">
                        <a href="/Descontar/Index" class="d-flex flex-column align-items-center text-white text-decoration-none w-100">
                            <div class="bg-white rounded-circle d-flex align-items-center justify-content-center mb-2 shadow-sm" style="width: 90px; height: 90px;">
                                <img src="~/Images/Logo.png" alt="Logo" style="max-height: 75%; max-width: 75%; object-fit: contain;" />
                            </div>
                            <span class="fs-4 fw-bold text-nowrap">TGRMX Inventario</span>
                        </a>
                    </div>

                    <hr class="border-secondary my-2">

                    <!-- Enlaces de Navegación Protegidos por Roles -->
                    <ul class="nav nav-pills flex-column mb-auto gap-1" id="menuNavegacion">
                        <li class="nav-item">
                            <a href="/Descontar/Index" class="nav-link text-white-50 d-flex align-items-center gap-2">
                                <i class="bi bi-house"></i> Home
                            </a>
                        </li>

                        <!-- 1. PRIMER FILTRO: El usuario debe estar logueado para ver cualquier módulo privado -->
                        @if (Context.Session.GetString("UsuarioID") != null)
                        {
                            var rolActual = Context.Session.GetString("UsuarioRol");

                            <li class="nav-item">
                                <a href="/Productos/Index" class="nav-link text-white-50 d-flex align-items-center gap-2">
                                    <i class="bi bi-box-seam"></i> Productos
                                </a>
                            </li>
                            <li class="nav-item">
                                <a href="/Proveedores/Index" class="nav-link text-white-50 d-flex align-items-center gap-2">
                                    <i class="bi bi-truck"></i> Proveedores
                                </a>
                            </li>
                            <li class="nav-item">
                                <a href="/Movimientos/Index" class="nav-link text-white-50 d-flex align-items-center gap-2">
                                    <i class="bi bi-clock-history"></i> Movimientos
                                </a>
                            </li>

                            <!-- 2. SEGUNDO FILTRO EXCLUSIVO: Ocultar botón 'Usuarios' si el rol es Requisitor -->
                            if (rolActual == "Admin" || rolActual == "Tecnico")
                            {
                                <li class="nav-item">
                                    <a href="/Usuarios/Index" class="nav-link text-white-50 d-flex align-items-center gap-2">
                                        <i class="bi bi-person"></i> Usuarios
                                    </a>
                                </li>
                            }
                        }
                        <li class="nav-item">
                            <a href="#" class="nav-link text-white-50 d-flex align-items-center gap-2">
                                <i class="bi bi-question-circle"></i> Help
                            </a>
                        </li>
                    </ul>

                    <hr class="border-secondary my-2">

                    <!-- SECCIÓN INFERIOR ADAPTATIVA -->
                    <div class="mt-auto pt-2 px-1">
                        @if (Context.Session.GetString("UsuarioID") != null)
                        {
                            <!-- Caso A: Sesión Activa -> Perfil del operador -->
                            <div class="bg-secondary bg-opacity-25 rounded-3 p-2 mb-2 border border-secondary border-opacity-25 text-center">
                                <div class="fw-bold text-white small text-truncate" title='@Context.Session.GetString("EmpleadoNombre")'>
                                    <i class="bi bi-person-circle me-1"></i> @Context.Session.GetString("EmpleadoNombre")
                                </div>
                                <div class="text-white-50 mt-1" style="font-size: 0.7rem; letter-spacing: 0.5px;">
                                    ROL: <span class="badge bg-primary text-uppercase px-2" style="font-size: 0.65rem;">@Context.Session.GetString("UsuarioRol")</span>
                                </div>
                            </div>

                            <a href="/Login/Logout" class="btn btn-sm btn-outline-danger w-100 rounded-pill fw-bold py-2 d-flex align-items-center justify-content-center gap-2">
                                <i class="bi bi-box-arrow-left fs-6"></i>
                                <span>Cerrar Sesión</span>
                            </a>
                        }
                        else
                        {
                            <!-- Caso B: Sesión Caducada -> Botón de inicio rápido -->
                            <a href="/Login/Index" class="btn btn-sm btn-light w-100 rounded-pill fw-bold py-2 shadow-sm d-flex align-items-center justify-content-center gap-2">
                                <i class="bi bi-box-arrow-in-right text-dark fs-6"></i>
                                <span class="text-dark">Iniciar Sesión</span>
                            </a>
                        }
                    </div>
                </div>
            </div>


            <main class="flex-grow-1 p-4 main-content-responsive" id="dashboardPrincipal">
                @RenderBody()
            </main>

        </div>
    </div>

        <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const currentUrl = window.location.pathname.toLowerCase();
            const menuLinks = document.querySelectorAll("#menuNavegacion .nav-link");

            // 1. Iluminación de la pestaña activa en el menú lateral
            menuLinks.forEach(link => {
                const linkUrl = link.getAttribute("href").toLowerCase();
                if (currentUrl === linkUrl || (linkUrl !== "/descontar/index" && currentUrl.startsWith(linkUrl))) {
                    link.classList.add("active");
                    link.classList.remove("text-white-50");
                }
            });

            // 2. SISTEMA DE RECARGA Y EXPULSIÓN AUTOMÁTICA EN TIEMPO REAL
            // Evaluamos el estado inicial que viene desde el servidor
            const sesionInicialActiva = @(Context.Session.GetString("UsuarioID") != null ? "true" : "false");
            
            // Si entra a una URL privada directamente sin sesión, expulsar de inmediato
            if (!sesionInicialActiva && currentUrl !== "/descontar/index" && currentUrl !== "/login/index" && currentUrl !== "/login") {
                window.location.href = "/Descontar/Index";
                return;
            }

            // Si el usuario tiene la sesión activa, monitoreamos en segundo plano cada 5 segundos
            if (sesionInicialActiva) {
                setInterval(function () {
                    fetch('/Login/CheckSession')
                        .then(res => res.json())
                        .then(data => {
                            // Si la sesión caducó en el servidor (data.active es false)
                            if (!data.active) {
                                // Si está en una página privada, recargar inmediatamente para forzar la expulsión
                                if (currentUrl !== "/descontar/index") {
                                    window.location.href = "/Descontar/Index";
                                } else {
                                    // Si ya estaba en la estación pública, solo recarga la página para ocultar los botones
                                    window.location.reload();
                                }
                            }
                        })
                        .catch(() => console.log("Monitoreo de sesión suspendido temporalmente por red."));
                }, 5000); // 5000 milisegundos = 5 segundos
            }
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
