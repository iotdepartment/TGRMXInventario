@model IEnumerable<TGRMXInventario.Models.MovimientoViewModel>

@{
    ViewData["Title"] = "Historial de Movimientos";
}
<div class="container-fluid py-4">
    <div class="row mb-4 align-items-center">
        <div class="col-12 col-md-6 mb-3 mb-md-0">
            <h4 class="m-0 fw-bold text-dark"><i class="bi bi-clock-history me-2"></i>Historial de Movimientos</h4>
            <p class="text-muted small m-0">Consulta la bitácora de auditoría, salidas de material y descuentos de almacén.</p>
        </div>
        <div class="col-12 col-md-6 text-md-end">
            <button id="btnExportarExcel" class="btn btn-sm btn-outline-success d-inline-flex align-items-center gap-2">
                <i class="bi bi-file-earmark-excel"></i> Exportar Historial
            </button>
        </div>
    </div>

    <!-- Barra de Búsqueda -->
    <div class="card shadow-sm border-0 mb-3">
        <div class="card-body p-3">
            <div class="input-group">
                <span class="input-group-text bg-white border-end-0 text-muted">
                    <svg xmlns="http://w3.org" width="16" height="16" fill="currentColor" class="text-muted" viewBox="0 0 16 16">
                        <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001q.044.06.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1 1 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0" />
                    </svg>
                </span>
                <input type="text" id="tablaBuscador" class="form-control border-start-0 ps-0" placeholder="Buscar por empleado, material, tipo o departamento..." />
            </div>
        </div>
    </div>

    <!-- Tarjeta de Contenedor de Tabla -->
    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table id="miTablaMovimientos" class="table table-hover align-middle mb-0">
                    <thead class="table-light text-uppercase fs-7 text-muted">
                        <tr>
                            <th class="ps-4" style="width: 80px;">ID</th>
                            <th>Empleado</th>
                            <th>Material / Producto</th>
                            <th>Tipo</th>
                            <th>Departamento</th>
                            <th>Fecha y Hora</th>
                            <th class="pe-4 text-end" style="width: 120px;">Cantidad</th>
                        </tr>
                    </thead>
                    <tbody id="tablaMovimientos">
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-4 fw-bold text-secondary">#@item.Id</td>
                                    <td>
                                        <div class="fw-semibold text-dark">@(item.NombreEmpleado ?? "Sin nombre")</div>
                                        <small class="text-muted">No. @(item.NumeroEmpleado ?? "N/A")</small>
                                    </td>
                                    <td>
                                        <span class="text-dark fw-medium small">@(item.NombreProducto ?? "Material no identificado")</span>
                                    </td>
                                    <td>
                                        @if (item.Tipo == "Descuento")
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill">Descuento</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-dark border rounded-pill">@item.Tipo</span>
                                        }
                                    </td>
                                    <td>
                                        <span class="text-muted small">@(item.Departamento ?? "Sin asignar")</span>
                                    </td>
                                    <td class="text-muted small">
                                        @(item.Fecha?.ToString("dd/MM/yyyy HH:mm") ?? "N/A")
                                    </td>
                                    <td class="pe-4 text-end fw-bold text-dark">
                                        @item.Cantidad
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5 text-muted">
                                    <i class="bi bi-clock-history display-4 d-block mb-3 text-secondary"></i>
                                    No se registran movimientos en la bitácora actual.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // ================= LÓGICA DE PAGINACIÓN NATIVA =================
            const filasPorPagina = 10;
            let paginaActual = 1;
            let filasFiltradas = [];

            const tablaBody = document.getElementById("tablaMovimientos");
            const buscador = document.getElementById("tablaBuscador");
            const tablaContenedor = document.getElementById("miTablaMovimientos");

            // Capturar el lote completo de filas renderizadas originalmente por el servidor
            const todasLasFilas = Array.from(tablaBody.querySelectorAll("tr")).filter(fila => fila.cells.length > 1);

            // Crear dinámicamente el contenedor de la paginación de Bootstrap 5 al pie de la tabla
            const paginacionContenedor = document.createElement("div");
            paginacionContenedor.className = "d-flex justify-content-between align-items-center mt-3 px-3";
            tablaContenedor.parentNode.appendChild(paginacionContenedor);

            function actualizarTabla() {
                const totalFilas = filasFiltradas.length;

                // Si la búsqueda no arroja coincidencias
                if (totalFilas === 0) {
                    tablaBody.innerHTML = `<tr><td colspan="7" class="text-center py-5 text-muted"><i class="bi bi-clock-history display-4 d-block mb-3 text-secondary"></i>No hay movimientos que coincidan con la búsqueda.</td></tr>`;
                    paginacionContenedor.innerHTML = "";
                    return;
                }

                // Cálculo estricto de los rangos de páginas
                const totalPaginas = Math.ceil(totalFilas / filasPorPagina);
                if (paginaActual > totalPaginas) paginaActual = totalPaginas;
                if (paginaActual < 1) paginaActual = 1;

                const inicio = (paginaActual - 1) * filasPorPagina;
                const fin = inicio + filasPorPagina;

                // Limpiar el cuerpo e inyectar únicamente las 10 filas de la página activa
                tablaBody.innerHTML = "";
                filasFiltradas.slice(inicio, fin).forEach(fila => {
                    tablaBody.appendChild(fila);
                });

                // Dibujar controles visuales de la barra inferior
                paginacionContenedor.innerHTML = `
                    <div class="text-muted small">Mostrando ${inicio + 1} al ${Math.min(fin, totalFilas)} de ${totalFilas}</div>
                    <nav>
                        <ul class="pagination pagination-sm m-0">
                            <li class="page-item ${paginaActual === 1 ? 'disabled' : ''}">
                                <button class="page-link" data-page="${paginaActual - 1}">Anterior</button>
                            </li>
                            ${Array.from({length: totalPaginas}, (_, i) => `
                                <li class="page-item ${paginaActual === i + 1 ? 'active' : ''}">
                                    <button class="page-link" data-page="${i + 1}">${i + 1}</button>
                                </li>
                            `).join('')}
                            <li class="page-item ${paginaActual === totalPaginas ? 'disabled' : ''}">
                                <button class="page-link" data-page="${paginaActual + 1}">Siguiente</button>
                            </li>
                        </ul>
                    </nav>`;
            }

            // Escuchar clics en los números de página o botones Anterior / Siguiente
            paginacionContenedor.addEventListener("click", function (e) {
                if (e.target.classList.contains("page-link") || e.target.tagName === "BUTTON") {
                    const nuevaPagina = parseInt(e.target.getAttribute("data-page"));
                    if (!isNaN(nuevaPagina) && nuevaPagina !== paginaActual) {
                        paginaActual = nuevaPagina;
                        actualizarTabla();
                    }
                }
            });

            // Motor de filtrado en tiempo real por entrada de teclado
            function filtrarFilas() {
                const query = buscador ? buscador.value.toLowerCase().trim() : "";
                filasFiltradas = todasLasFilas.filter(fila => {
                    if (!query) return true;
                    return fila.textContent.toLowerCase().includes(query);
                });
                paginaActual = 1; // Forzar reinicio de página al escribir
                actualizarTabla();
            }

            if (buscador) buscador.addEventListener("input", filtrarFilas);
            filtrarFilas(); // Inicialización automática en la carga de la página


            // ================= BOTÓN EXPORTAR HISTORIAL A EXCEL =================
            const btnExportar = document.getElementById("btnExportarExcel");
            if (btnExportar) {
                btnExportar.addEventListener("click", function () {
                    if (todasLasFilas.length === 0) return;

                    let csv = [];
                    const ths = tablaContenedor.querySelectorAll("thead th");
                    const cabeceras = Array.from(ths).map(th => `"${th.textContent.trim().replace(/"/g, '""')}"`);
                    csv.push(cabeceras.join(","));

                    // Recorremos el lote completo para exportar todo el historial sin importar la paginación visible
                    todasLasFilas.forEach(fila => {
                        const celdas = fila.querySelectorAll("td");
                        if (celdas.length < 2) return;

                        let filaDatos = [
                            `"${celdas[0].textContent.trim().replace("#", "")}"`,              // ID
                            `"${celdas[1].textContent.trim().replace(/\s+/g, ' ')}"`,          // Empleado completo
                            `"${celdas[2].textContent.trim()}"`,                              // Material
                            `"${celdas[3].textContent.trim()}"`,                              // Tipo
                            `"${celdas[4].textContent.trim()}"`,                              // Departamento
                            `"${celdas[5].textContent.trim()}"`,                              // Fecha
                            `"${celdas[6].textContent.trim()}"`                               // Cantidad
                        ];
                        csv.push(filaDatos.join(","));
                    });

                    // Añadir prefijo BOM UTF-8 para garantizar acentos correctos en Microsoft Excel
                    const csvContenido = "\uFEFF" + csv.join("\n");
                    const blob = new Blob([csvContenido], { type: "text/csv;charset=utf-8;" });
                    const link = document.createElement("a");

                    link.setAttribute("href", URL.createObjectURL(blob));
                    link.setAttribute("download", `Movimientos_Almacen_TGRMX_${new Date().toISOString().slice(0, 10)}.csv`);
                    link.style.visibility = 'hidden';

                    document.body.appendChild(link);
                    link.click();
                    document.body.removeChild(link);
                });
            }

            console.log("Módulo visual de bitácora e historial inicializado.");
        });
    </script>
}
