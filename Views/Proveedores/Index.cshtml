@model IEnumerable<TGRMXInventario.Models.Proveedores>

@{
    ViewData["Title"] = "Gestión de Proveedores";
}

<div class="container-fluid py-4">
    <!-- Encabezado y Acción Principal -->
    <div class="row mb-4 align-items-center">
        <div class="col-12 col-md-6 mb-3 mb-md-0">
            <h4 class="m-0 fw-bold text-dark"><i class="bi bi-truck me-2"></i>Proveedores</h4>
            <p class="text-muted small m-0">Administra el catálogo de proveedores y sus datos de contacto.</p>
        </div>
        <div class="col-12 col-md-6 text-md-end d-flex flex-wrap gap-2 justify-content-md-end">
            <button id="btnExportarExcel" class="btn btn-sm btn-outline-success d-inline-flex align-items-center gap-2">
                <i class="bi bi-file-earmark-excel"></i> Exportar
            </button>
            <button type="button" class="btn btn-sm btn-primary d-inline-flex align-items-center gap-2" data-bs-toggle="modal" data-bs-target="#createProveedorModal">
                <i class="bi bi-plus-circle"></i> Nuevo Proveedor
            </button>
        </div>
    </div>

    <!-- Barra de Búsqueda -->
    <div class="card style-float mb-3">
        <div class="card-body p-3">
            <div class="input-group">
                <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-search"></i></span>
                <input type="text" id="tablaBuscador" class="form-control border-start-0 ps-0" placeholder="Buscar por nombre, contacto, correo o teléfono..." />
            </div>
        </div>
    </div>

    <!-- Tarjeta de Contenedor de Tabla -->
    <div class="card style-float">
        <div class="card-body p-3">
            <div class="table-responsive">
                <table id="miTablaProveedores" class="table table-hover align-middle mb-0">
                    <thead class="table-light text-uppercase fs-7 text-muted">
                        <tr>
                            <!-- SE REMOVIÓ LA COLUMNA DE ID -->
                            <th class="ps-4">Proveedor</th>
                            <th>Área</th> <!-- NUEVA COLUMNA VISIBLE -->
                            <th>Contacto Principal</th>
                            <th>Correo Electrónico</th>
                            <th>Teléfono</th>
                            <th class="pe-4 text-end" style="width: 180px;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody id="tablaProveedores">
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <!-- SE REMOVIÓ LA CELDA DE ID -->
                                    <td class="ps-4">
                                        <div class="fw-semibold text-dark">@(item.NombreProveedor ?? "Sin nombre")</div>
                                    </td>
                                    <td>
                                        <!-- NUEVA CELDA: Muestra el Área asignada con estilo de badge -->
                                        <span class="badge bg-light text-secondary border">
                                            @(item.Area ?? "Sin Área")
                                        </span>
                                    </td>
                                    <td>
                                        <span class="text-dark small">@(item.Contacto ?? "Sin contacto")</span>
                                    </td>
                                    <td>
                                        <span class="text-muted small">@(item.Correo ?? "Sin correo")</span>
                                    </td>
                                    <td>
                                        <span class="text-muted small">@(item.Telefono ?? "Sin teléfono")</span>
                                    </td>
                                    <td class="pe-4 text-end">
                                        <div class="btn-group" role="group">
                                            <button type="button" class="btn btn-sm btn-outline-warning btn-editar"
                                                    data-id="@item.Id"
                                                    data-nombre="@item.NombreProveedor"
                                                    data-area="@item.Area"
                                                    data-contacto="@item.Contacto"
                                                    data-correo="@item.Correo"
                                                    data-telefono="@item.Telefono">
                                                <i class="bi bi-pencil"></i>
                                            </button>
                                            <button type="button" class="btn btn-sm btn-outline-danger btn-eliminar"
                                                    data-id="@item.Id" data-nombre="@item.NombreProveedor" title="Eliminar">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <!-- Se ajustó el colspan a 6 columnas tras quitar el ID y agregar el Área -->
                                <td colspan="6" class="text-center py-5 text-muted">
                                    <i class="bi bi-truck display-4 d-block mb-3 text-secondary"></i>
                                    No hay proveedores registrados.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

            </div>
        </div>
    </div>
</div>

<!-- ================= MODALES DE ACCIÓN ================= -->
<div class="modal fade" id="createProveedorModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title fw-bold fs-6"><i class="bi bi-plus-circle me-2"></i>Agregar Proveedor</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-controller="Proveedores" asp-action="Create" method="post">
                <div class="modal-body p-4">

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-muted">Nombre del Proveedor</label>
                        <input type="text" name="NombreProveedor" class="form-control" required />
                    </div>

                    <!-- Validación de Rol con Razor desde el Servidor -->
                    @if (Context.Session.GetString("UsuarioRol") != "Requisitor")
                    {
                        <!-- Solo se renderiza si el usuario es Admin o Técnico -->
                        <div class="mb-3">
                            <label class="form-label small fw-semibold text-muted">Área</label>
                            <select name="Area" class="form-select" required>
                                <option value="" disabled selected>-- Selecciona un Área --</option>
                                <option value="Mantenimiento">Mantenimiento</option>
                                <option value="Recursos Humanos">Recursos Humanos</option>
                            </select>
                        </div>
                    }

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-muted">Persona de Contacto</label>
                        <input type="text" name="Contacto" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-muted">Correo Electrónico</label>
                        <input type="email" name="Correo" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-muted">Teléfono</label>
                        <input type="tel" name="Telefono" class="form-control" />
                    </div>
                </div>
                <div class="modal-footer bg-light border-0">
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-sm btn-primary">Guardar Proveedor</button>
                </div>
            </form>
        </div>
    </div>
</div>


<!-- Modal: Editar Proveedor Adaptativo y Seguro -->
<div class="modal fade" id="editProveedorModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-warning text-dark">
                <h5 class="modal-title fw-bold fs-6"><i class="bi bi-pencil me-2"></i>Editar Proveedor</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-controller="Proveedores" asp-action="Edit" method="post">
                <input type="hidden" id="edit_Id" name="Id" />
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-muted">Nombre del Proveedor</label>
                        <input type="text" id="edit_NombreProveedor" name="NombreProveedor" class="form-control" required />
                    </div>

                    <!-- Validación de Rol con Razor desde el Servidor -->
                    @if (Context.Session.GetString("UsuarioRol") != "Requisitor")
                    {
                        <!-- Solo se muestra si el usuario es Admin o Técnico -->
                        <div class="mb-3">
                            <label class="form-label small fw-semibold text-muted">Área</label>
                            <select id="edit_Area" name="Area" class="form-select" required>
                                <option value="Mantenimiento">Mantenimiento</option>
                                <option value="Recursos Humanos">Recursos Humanos</option>
                            </select>
                        </div>
                    }

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-muted">Persona de Contacto</label>
                        <input type="text" id="edit_Contacto" name="Contacto" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-muted">Correo Electrónico</label>
                        <input type="email" id="edit_Correo" name="Correo" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-muted">Teléfono</label>
                        <input type="tel" id="edit_Telefono" name="Telefono" class="form-control" />
                    </div>
                </div>
                <div class="modal-footer bg-light border-0">
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-sm btn-warning">Actualizar</button>
                </div>
            </form>
        </div>
    </div>
</div>


<!-- Modal: Eliminar Proveedor -->
<div class="modal fade" id="deleteProveedorModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title fw-bold fs-6"><i class="bi bi-exclamation-triangle me-2"></i>¿Eliminar?</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <!-- Envía la petición POST al método Delete del ProveedoresController -->
            <form asp-controller="Proveedores" asp-action="Delete" method="post">
                <!-- Campo oculto para mandar el ID del proveedor seleccionado -->
                <input type="hidden" id="delete_Id" name="Id" />

                <div class="modal-body p-3 text-center">
                    <p class="m-0 small text-muted">¿Estás seguro de eliminar al proveedor?</p>
                    <!-- Aquí el script inyecta dinámicamente el nombre del proveedor -->
                    <p class="fw-bold text-dark mt-1 mb-0" id="delete_NombreProveedor"></p>
                </div>
                <div class="modal-footer bg-light border-0 justify-content-center">
                    <button type="button" class="btn btn-xs btn-outline-secondary" data-bs-dismiss="modal">No, cancelar</button>
                    <button type="submit" class="btn btn-xs btn-danger">Sí, eliminar</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Variables de Paginación
            const filasPorPagina = 10;
            let paginaActual = 1;
            let filasFiltradas = [];

            const tablaBody = document.getElementById("tablaProveedores");
            const buscador = document.getElementById("tablaBuscador");
            const tablaContenedor = document.getElementById("miTablaProveedores");

            // Capturar filas iniciales generadas por el servidor
            const todasLasFilas = Array.from(tablaBody.querySelectorAll("tr")).filter(fila => fila.cells.length > 1);

            // Crear contenedor visual de paginación debajo de la tabla
            const paginacionContenedor = document.createElement("div");
            paginacionContenedor.className = "d-flex justify-content-between align-items-center mt-3 px-3";
            tablaContenedor.parentNode.appendChild(paginacionContenedor);

            function actualizarTabla() {
                const totalFilas = filasFiltradas.length;

                if (totalFilas === 0) {
                    tablaBody.innerHTML = `<tr><td colspan="6" class="text-center py-5 text-muted"><i class="bi bi-truck display-4 d-block mb-3 text-secondary"></i>No hay proveedores que coincidan.</td></tr>`;
                    paginacionContenedor.innerHTML = "";
                    return;
                }

                const totalPaginas = Math.ceil(totalFilas / filasPorPagina);
                if (paginaActual > totalPaginas) paginaActual = totalPaginas;
                if (paginaActual < 1) paginaActual = 1;

                const inicio = (paginaActual - 1) * filasPorPagina;
                const fin = inicio + filasPorPagina;

                tablaBody.innerHTML = "";
                filasFiltradas.slice(inicio, fin).forEach(fila => {
                    tablaBody.appendChild(fila);
                });

                // Renderizado dinámico de la paginación estilo Bootstrap 5
                paginacionContenedor.innerHTML = `
                    <div class="text-muted small">Mostrando ${inicio + 1} al ${Math.min(fin, totalFilas)} de ${totalFilas}</div>
                    <nav>
                        <ul class="pagination pagination-sm m-0">
                            <li class="page-item ${paginaActual === 1 ? 'disabled' : ''}">
                                <button class="page-link" data-page="${paginaActual - 1}">Anterior</button>
                            </li>
                            ${Array.from({length: totalPaginas}, (_, i) => `
                                <li class="page-item ${paginaActual === i + 1 ? 'active' : ''}">
                                    <button class="page-link" data-page="${i + 1}">${i + 1}</button>
                                </li>
                            `).join('')}
                            <li class="page-item ${paginaActual === totalPaginas ? 'disabled' : ''}">
                                <button class="page-link" data-page="${paginaActual + 1}">Siguiente</button>
                            </li>
                        </ul>
                    </nav>`;
            }

            paginacionContenedor.addEventListener("click", function (e) {
                if (e.target.classList.contains("page-link") || e.target.tagName === "BUTTON") {
                    const nuevaPagina = parseInt(e.target.getAttribute("data-page"));
                    if (!isNaN(nuevaPagina) && nuevaPagina !== paginaActual) {
                        paginaActual = nuevaPagina;
                        actualizarTabla();
                    }
                }
            });

            function filtrarFilas() {
                const query = buscador ? buscador.value.toLowerCase().trim() : "";
                filasFiltradas = todasLasFilas.filter(fila => {
                    if (!query) return true;
                    return fila.textContent.toLowerCase().includes(query);
                });
                paginaActual = 1;
                actualizarTabla();
            }

            if (buscador) buscador.addEventListener("input", filtrarFilas);
            filtrarFilas();

            // --- Lógica del botón exportar autónomo ---
            const btnExportar = document.getElementById("btnExportarExcel");
            if (btnExportar) {
                btnExportar.addEventListener("click", function () {
                    if (todasLasFilas.length === 0) return;

                    let csv = [];
                    const ths = tablaContenedor.querySelectorAll("thead th");
                    const cabeceras = Array.from(ths).slice(0, -1).map(th => `"${th.textContent.trim().replace(/"/g, '""')}"`);
                    csv.push(cabeceras.join(","));

                    todasLasFilas.forEach(fila => {
                        const celdas = fila.querySelectorAll("td");
                        if (celdas.length < 2) return;

                        let filaDatos = [
                            `"${celdas[0].textContent.trim().replace("#", "")}"`,                               // ID
                            `"${celdas[1].querySelector(".fw-semibold")?.textContent.trim() || ""}"`,          // Proveedor
                            `"${celdas[2].textContent.trim()}"`,                                               // Contacto
                            `"${celdas[3].textContent.trim()}"`,                                               // Correo
                            `"${celdas[4].textContent.trim()}"`                                                // Teléfono
                        ];
                        csv.push(filaDatos.join(","));
                    });

                    const csvContenido = "\uFEFF" + csv.join("\n");
                    const blob = new Blob([csvContenido], { type: "text/csv;charset=utf-8;" });
                    const link = document.createElement("a");
                    link.setAttribute("href", URL.createObjectURL(blob));
                    link.setAttribute("download", `Proveedores_TGRMX_${new Date().toISOString().slice(0, 10)}.csv`);
                    link.style.visibility = 'hidden';
                    document.body.appendChild(link);
                    link.click();
                    document.body.removeChild(link);
                });
            }

            // --- Gestión de Modales ---
            const modalEdicion = new bootstrap.Modal(document.getElementById('editProveedorModal'));
            const modalEliminacion = new bootstrap.Modal(document.getElementById('deleteProveedorModal'));

            tablaBody.addEventListener('click', function (e) {
                const btnEditar = e.target.closest('.btn-editar');
                const btnEliminar = e.target.closest('.btn-eliminar');

                if (btnEditar) {
                    document.getElementById('edit_Id').value = btnEditar.getAttribute('data-id');
                    document.getElementById('edit_NombreProveedor').value = btnEditar.getAttribute('data-nombre');
                    document.getElementById('edit_Contacto').value = btnEditar.getAttribute('data-contacto');
                    document.getElementById('edit_Correo').value = btnEditar.getAttribute('data-correo');
                    document.getElementById('edit_Telefono').value = btnEditar.getAttribute('data-telefono');

                    // CONTROL DE CONTROL: Solo asigna valor si el select 'edit_Area' existe en la pantalla
                    const selectAreaEdit = document.getElementById('edit_Area');
                    if (selectAreaEdit) {
                        selectAreaEdit.value = btnEditar.getAttribute('data-area') || "";
                    }

                    modalEdicion.show();
                }



                if (btnEliminar) {
                    document.getElementById('delete_Id').value = btnEliminar.getAttribute('data-id');
                    document.getElementById('delete_NombreProveedor').textContent = btnEliminar.getAttribute('data-nombre');
                    modalEliminacion.show();
                }
            });

            console.log("Módulo completo de proveedores cargado con éxito.");
        });
    </script>
}
